# PolyInsight 환경변수 — 복사해서 .env로 사용 (.env는 git 커밋 금지)
# 로컬 개발: 백엔드 루트에서 로드됨 / 배포: docker-compose가 env_file로 로드.

# ── 백엔드 LLM / 시크릿 ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...          # 운영자(개발자) 키
LLM_MODEL=claude-haiku-4-5-20251001
LLM_MODEL_ARCHITECT=claude-sonnet-4-6
DATABASE_URL=./polyinsight.db         # 배포(compose)에서는 sqlite:////data/polyinsight.db로 덮어씀
PLAYWRIGHT_TIMEOUT_MS=15000
EXPORT_TTL_HOURS=24
MAX_CONCURRENT_JOBS=5
DEBUG=False

# ── 인증 / 세션 (Plan 1) ──────────────────────────────────────
SESSION_TTL_HOURS=72
COOKIE_SECURE=False                    # 로컬 http=False / 배포(터널 HTTPS)=True
RENDER_TOKEN=                          # 배포 시 랜덤 32자: `openssl rand -hex 16`. S7 렌더 내부 인증.

# ── PostHog (선택, 행동분석/세션리플레이 · Plan 2) ─────────────
# 비우면 프론트에서 완전 no-op. NEXT_PUBLIC_* 는 빌드 시점 인라인.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Cloudflare Tunnel (배포 · Plan 3) ─────────────────────────
TUNNEL_TOKEN=                          # Zero Trust 대시보드에서 발급한 터널 토큰

# ── 스톡 이미지 검색 (선택) ────────────────────────────────────
# 비우면 /api/images/search가 빈 결과 반환 (에디터는 정상 동작, 업로드만 가능)
PEXELS_API_KEY=                        # https://www.pexels.com/api/
UNSPLASH_ACCESS_KEY=                   # https://unsplash.com/developers (Access Key만 필요, Secret 불필요)
