# PolyInsight 환경변수 — 복사해서 .env로 사용 (.env는 git 커밋 금지)
# 로컬 개발: 백엔드 루트에서 로드됨 / 배포: docker-compose가 env_file로 로드.

# ── 백엔드 LLM / 시크릿 ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...          # 운영자(개발자) 키
LLM_MODEL=claude-haiku-4-5-20251001
LLM_MODEL_ARCHITECT=claude-sonnet-4-6
DATABASE_URL=./polyinsight.db         # 배포(compose)에서는 sqlite:////data/polyinsight.db로 덮어씀
STORAGE_DIR=backend/var/blobstore     # L1 파일저장(카드PNG·export·유저자산). 배포(compose)=/data/blobstore(영속 볼륨)로 덮어씀 — 안 하면 재배포 시 증발(C3)
PLAYWRIGHT_TIMEOUT_MS=15000
EXPORT_TTL_HOURS=24
MAX_CONCURRENT_JOBS=5                  # 동시 파이프라인(각각 Chromium 렌더). VM RAM 4GB(B2s)면 OOM 방지로 2~3 권장
DEBUG=False

# ── 인증 / 세션 (Plan 1) ──────────────────────────────────────
SESSION_TTL_HOURS=72
COOKIE_SECURE=False                    # 로컬 http=False / 배포(터널 HTTPS)=True (필수)
RENDER_TOKEN=                          # 배포 시 강한 랜덤: `openssl rand -hex 32`. 갓토큰(전 유저 우회) — 최상위 시크릿, 로그 금지.

# ── CORS / rate limit (보안 하드닝 2026-07-02) ────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000   # 배포=공개 Cloudflare 터널 도메인(쉼표구분)
RATE_LIMIT_ENABLED=True                # 로그인/가입 브루트포스·스팸 방어(인메모리, 단일워커 전제). 로컬 수동테스트 방해되면 False
PASSWORD_MAX_LEN=128

# ── 업로드 쿼터 (Anthropic 재정 DoS 방어 — 파일럿에선 낮춰도 됨) ──
UPLOAD_USER_LIMIT=20                    # 인증 유저 일일 업로드 상한(파일럿=5 권장). 덱 1건=Opus 실비
UPLOAD_UNVERIFIED_LIMIT=3              # 미인증 계정 일일 상한(grace)

# ── 이메일 인증 (Resend) ──────────────────────────────────────
RESEND_API_KEY=                        # 비우면 인증메일 발송 no-op. https://resend.com 에서 발급
EMAIL_FROM=onboarding@resend.dev       # 도메인 DKIM 검증 후 you@yourdomain 로 교체
PUBLIC_BASE_URL=                       # ⚠️ 배포 필수: 공개 터널 도메인(예: https://app.example.com). 비우면 WEB_BASE_URL 폴백(내부호스트=링크 깨짐)

# ── PostHog (선택, 행동분석/세션리플레이 · Plan 2) ─────────────
# 비우면 프론트에서 완전 no-op. NEXT_PUBLIC_* 는 빌드 시점 인라인.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Cloudflare Tunnel (배포 · Plan 3) ─────────────────────────
TUNNEL_TOKEN=                          # Zero Trust 대시보드에서 발급한 터널 토큰

# ── 스톡 이미지 검색 (선택) ────────────────────────────────────
# 비우면 /api/images/search가 빈 결과 반환 (에디터는 정상 동작, 업로드만 가능)
PEXELS_API_KEY=                        # https://www.pexels.com/api/
UNSPLASH_ACCESS_KEY=                   # https://unsplash.com/developers (Access Key만 필요, Secret 불필요)
